#!/usr/bin/env bash
set -u
set -o pipefail

SELF="$(realpath -- "${BASH_SOURCE[0]}")" || {
    printf 'git-secret-guard: cannot resolve the location of this script\n' >&2
    exit 1
}
# ^ invariant GSG_ROOT = two levels above this script, in a checkout and in the installed share dir alike
GSG_ROOT="${SELF%/*/*}"

# ^ invariant brew.sh is bash 3.2 safe and the bootstrap runs before any other library is read => bash 3.2 never reaches a construct it cannot parse
# shellcheck source=/dev/null
source "$GSG_ROOT/lib/brew.sh" || exit 1
# ^ why a startup trap only, not one for the whole run; a bare ^C told the user nothing, and each command sets its own traps once it has a change to undo
# ^ invariant the text is built when the signal arrives => a Homebrew install this run made is named; the bootstrap clears the traps before brew install bash
trap 'printf "\ngit-secret-guard: interrupted while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 130' INT
trap 'printf "\ngit-secret-guard: terminated while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 143' TERM
trap 'printf "\ngit-secret-guard: hung up while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 129' HUP
brew_cli_bootstrap "$SELF" "$@" || exit 1

for lib in common state tools hookspath exempt timer launchd wsl install install_tools gitup gitup_source uninstall status doctor doctor_repos doctor_findings; do
    # shellcheck source=/dev/null
    source "$GSG_ROOT/lib/$lib.sh" || exit 1
done
brew_use_gnubin "${1:-}" || exit 1
trap - INT TERM HUP

# shellcheck disable=SC2329
cli_version() {
    local v
    v="$(<"$GSG_ROOT/VERSION")" || return 1
    if [[ ! $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s: %s/VERSION is not x.y.z: [%s]\n' "$GSG_NAME" "$GSG_ROOT" "$v" >&2
        return 1
    fi
    printf '%s %s\n' "$GSG_NAME" "$v"
}

cli_usage() { cat -- "$GSG_ROOT/lib/usage.md"; }

usage_error() {
    printf '%s: %s\n' "$GSG_NAME" "$1" >&2
    cli_usage >&2
    return 2
}

cmd_install() {
    local arg replace=0 timer=0 upgrade=0 takeover=0
    for arg in "$@"; do
        case "$arg" in
            --replace-hooks-path) replace=1 ;;
            --with-timer) timer=1 ;;
            --upgrade-git) upgrade=1 ;;
            --take-over-system-git) takeover=1 ;;
            *)
                usage_error "install: unknown option [$arg]"
                return
                ;;
        esac
    done
    install_run "$replace" "$timer" "$upgrade" "$takeover"
}

cmd_uninstall() {
    local arg remove=0 keep=0
    for arg in "$@"; do
        case "$arg" in
            --remove-tools) remove=1 ;;
            --keep-system-git) keep=1 ;;
            *)
                usage_error "uninstall: unknown option [$arg]"
                return
                ;;
        esac
    done
    uninstall_run "$remove" "$keep"
}

# ^ invariant arguments after --roots up to the next option are roots; anything else is a usage error (exit 2, same as a doctor error)
cmd_doctor() {
    local arg listing=0 recheck=0
    local -a roots=()
    for arg in "$@"; do
        case "$arg" in
            --roots) listing=1 ;;
            --recheck) recheck=1 ;;
            -*)
                usage_error "doctor: unknown option [$arg]"
                return
                ;;
            *)
                if [ "$listing" -ne 1 ]; then
                    usage_error "doctor: unexpected argument [$arg]"
                    return
                fi
                roots+=("$arg")
                ;;
        esac
    done
    if [ "$recheck" -eq 1 ] && [ "$listing" -eq 1 ]; then
        usage_error "doctor: --recheck re-checks the recorded findings and takes no --roots"
        return
    fi
    if [ "$recheck" -eq 1 ]; then
        doctor_recheck
        return
    fi
    if [ "$listing" -eq 1 ] && [ "${#roots[@]}" -eq 0 ]; then
        usage_error "doctor: --roots needs at least one directory"
        return
    fi
    doctor_run "${roots[@]}"
}

cmd_plain() {
    local cmd="$1" fn="$2"
    shift 2
    if [ "$#" -gt 0 ]; then
        usage_error "$cmd takes no arguments"
        return
    fi
    "$fn"
}

main() {
    local cmd="${1:-}"
    if [ "$#" -eq 0 ]; then
        usage_error "missing command"
        return
    fi
    shift
    case "$cmd" in
        install) cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        status) cmd_plain status status_run "$@" ;;
        restore-system-git) cmd_plain restore-system-git gitup_restore_run "$@" ;;
        doctor) cmd_doctor "$@" ;;
        version | --version) cmd_plain "$cmd" cli_version "$@" ;;
        help | --help | -h) cmd_plain "$cmd" cli_usage "$@" ;;
        *) usage_error "unknown command [$cmd]" ;;
    esac
}

# ^ order exit right after main => bash reads no further in a script install or uninstall may replace mid-run
main "$@"
exit

#!/usr/bin/env bash
set -u
set -o pipefail

# ^ external macOS 12 has no realpath in /usr/bin or /bin, and BSD tools run this under bash 3.2; only builtins, readlink and cd -P here
# ^ why a copy of the walk in hooks/secret-scan, not a library function; neither file can source a library before it knows where it is
# ^ invariant at most 40 readlink calls (below the kernel's own limit) => a chain without an end is refused, never followed for ever
gsg_walk="${BASH_SOURCE[0]}" gsg_dir="" gsg_next="" gsg_settled=0
# ^ invariant bash 3.2 syntax only (a C-style for, no namerefs) => the walk parses before the bootstrap re-executes under bash 4.4
for ((gsg_hop = 0; gsg_hop < 40; gsg_hop++)); do
    case "$gsg_walk" in
        */*) gsg_dir="${gsg_walk%/*}"; if [ -z "$gsg_dir" ]; then gsg_dir=/; fi ;;
        *) gsg_dir=. ;;
    esac
    # ^ why CDPATH= in front, not left as it is; an exported CDPATH makes cd search it and print the directory it chose
    gsg_dir="$(CDPATH='' cd -P -- "$gsg_dir" && pwd -P)" || break
    gsg_walk="${gsg_dir%/}/${gsg_walk##*/}"
    # ^ why -f, not only not-a-link; realpath refused a missing path, and a missing script must be refused with the message below
    if [ ! -L "$gsg_walk" ]; then if [ -f "$gsg_walk" ]; then gsg_settled=1; fi; break; fi
    gsg_next="$(readlink "$gsg_walk")" || break
    case "$gsg_next" in
        /*) gsg_walk="$gsg_next" ;;
        *) gsg_walk="${gsg_dir%/}/$gsg_next" ;;
    esac
done
# ^ see test:test_the_cli_started_through_links_finds_its_share_with_a_PATH_that_has_no_realpath
# ^ see test:test_the_cli_refuses_a_link_that_never_settles_instead_of_hanging
# ^ see test:test_the_cli_refuses_a_link_whose_target_is_not_a_file
if [ "$gsg_settled" -ne 1 ]; then
    printf 'git-secret-guard: cannot resolve the location of this script\n' >&2
    exit 1
fi
SELF="$gsg_walk"
# ^ invariant GSG_ROOT = two levels above this script, in a checkout and in the installed share dir alike
GSG_ROOT="${SELF%/*/*}"

# ^ security a platform answer in the environment is never trusted; this process asks uname itself, once, and never passes the answer on (docs/platforms.md)
# ^ invariant the bootstrap's exec of a newer bash runs this file again => the new image unsets both and asks uname itself, never inherits
unset GSG_UNAME_S GSG_UNAME_M

# ^ invariant brew.sh is bash 3.2 safe and the bootstrap runs before any other library is read => bash 3.2 never reaches a construct it cannot parse
# shellcheck source=/dev/null
source "$GSG_ROOT/lib/platform/brew.sh" || exit 1
# ^ why a startup trap only, not one for the whole run; a bare ^C told the user nothing, and each command sets its own traps once it has a change to undo
# ^ invariant the text is built when the signal arrives => a Homebrew install this run made is named; the bootstrap clears the traps before brew install bash
trap 'printf "\ngit-secret-guard: interrupted while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 130' INT
trap 'printf "\ngit-secret-guard: terminated while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 143' TERM
trap 'printf "\ngit-secret-guard: hung up while starting; %s\n" "$(brew_unchanged_text)" >&2; exit 129' HUP
brew_cli_bootstrap "$SELF" "$@" || exit 1

for lib in core/common core/state install/tools install/hookspath scan/exempt autoupdate/timer platform/launchd platform/wsl install/install install/install_path install/install_created platform/macpath platform/winpath autoupdate/install_timer install/install_cmd install/install_tools gitup/gitup gitup/gitup_source integrations/smartgit/smartgit integrations/smartgit/smartgit_report integrations/smartgit/smartgit_offer integrations/smartgit/smartgit_lfs integrations/smartgit/smartgit_apply integrations/smartgit/smartgit_flatpak integrations/desktop/desktop_git integrations/desktop/desktop_git_check integrations/desktop/desktop_git_report install/uninstall inspect/status inspect/doctor inspect/doctor_repos inspect/doctor_findings autoupdate/autoupdate platform/winupdate platform/schtasks autoupdate/autoupdate_report; do
    # shellcheck source=/dev/null
    source "$GSG_ROOT/lib/$lib.sh" || exit 1
done
brew_use_gnubin "${1:-}" || exit 1
trap - INT TERM HUP

# shellcheck disable=SC2329
cli_version() {
    local v
    v="$(<"$GSG_ROOT/VERSION")" || return 1
    if [[ ! $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s: %s/VERSION is not x.y.z: [%s]\n' "$GSG_NAME" "$GSG_ROOT" "$v" >&2
        return 1
    fi
    printf '%s %s\n' "$GSG_NAME" "$v"
}

cli_usage() { cat -- "$GSG_ROOT/lib/cli/usage.md"; }

usage_error() {
    printf '%s: %s\n' "$GSG_NAME" "$1" >&2
    cli_usage >&2
    return 2
}

cmd_install() {
    local arg replace=0 timer=0 upgrade=0 takeover=0 smartgit=0 sandbox=0
    local desktop=0 autoupdate=0 nosmartgit=0 nodesktop=0
    local nopath=0
    for arg in "$@"; do
        case "$arg" in
            --replace-hooks-path) replace=1 ;;
            --with-timer) timer=1 ;;
            --auto-update) autoupdate=1 ;;
            --upgrade-git) upgrade=1 ;;
            --take-over-system-git) takeover=1 ;;
            --configure-smartgit) smartgit=1 ;;
            --dont-configure-smartgit) nosmartgit=1 ;;
            --allow-smartgit-sandbox-removal) sandbox=1 ;;
            --link-desktop-git) desktop=1 ;;
            --dont-link-desktop-git) nodesktop=1 ;;
            --dont-change-path) nopath=1 ;;
            *)
                usage_error "install: unknown option [$arg]"
                return
                ;;
        esac
    done
    if [ "$smartgit" -eq 1 ] && [ "$nosmartgit" -eq 1 ]; then
        usage_error "install: --configure-smartgit and --dont-configure-smartgit contradict each other"
        return
    fi
    if [ "$desktop" -eq 1 ] && [ "$nodesktop" -eq 1 ]; then
        usage_error "install: --link-desktop-git and --dont-link-desktop-git contradict each other"
        return
    fi
    if [ "$sandbox" -eq 1 ] && [ "$nosmartgit" -eq 1 ]; then
        usage_error "install: --allow-smartgit-sandbox-removal and --dont-configure-smartgit contradict each other"
        return
    fi
    # ^ why globals, not install_run arguments; read by smartgit_install_step, desktop_git_install_step and by install_run for the flags text
    # shellcheck disable=SC2034
    SMARTGIT_OFF_FLAG="$nosmartgit" DESKTOP_GIT_OFF_FLAG="$nodesktop"
    # ^ why a global, not an install_run argument; lib/install/install.sh is at its size limit
    # shellcheck disable=SC2034
    SMARTGIT_SANDBOX_FLAG="$sandbox"
    # ^ why a global too, not an install_run argument; read by desktop_git_precheck and desktop_git_install_step
    # shellcheck disable=SC2034
    DESKTOP_GIT_FLAG="$desktop"
    # ^ why a global too, not an install_run argument; read by install_prepare_update of lib/autoupdate/install_timer.sh and by install_run for the flags text
    # shellcheck disable=SC2034
    AUTO_UPDATE_FLAG="$autoupdate"
    # ^ why a global too, not an install_run argument; read by install_path_plan of lib/install/install_path.sh and by install_run for the flags text
    # shellcheck disable=SC2034
    INSTALL_PATH_FLAG="$nopath"
    install_run "$replace" "$timer" "$upgrade" "$takeover" "$smartgit"
}

cmd_uninstall() {
    local arg remove=0 keep=0
    for arg in "$@"; do
        case "$arg" in
            --remove-tools) remove=1 ;;
            --keep-system-git) keep=1 ;;
            *)
                usage_error "uninstall: unknown option [$arg]"
                return
                ;;
        esac
    done
    uninstall_run "$remove" "$keep"
}

# ^ invariant arguments after --roots up to the next option are roots; anything else is a usage error (exit 2, same as a doctor error)
cmd_doctor() {
    local arg listing=0 recheck=0
    local -a roots=()
    for arg in "$@"; do
        case "$arg" in
            --roots) listing=1 ;;
            --recheck) recheck=1 ;;
            -*)
                usage_error "doctor: unknown option [$arg]"
                return
                ;;
            *)
                if [ "$listing" -ne 1 ]; then
                    usage_error "doctor: unexpected argument [$arg]"
                    return
                fi
                roots+=("$arg")
                ;;
        esac
    done
    if [ "$recheck" -eq 1 ] && [ "$listing" -eq 1 ]; then
        usage_error "doctor: --recheck re-checks the recorded findings and takes no --roots"
        return
    fi
    if [ "$recheck" -eq 1 ]; then
        doctor_recheck
        return
    fi
    if [ "$listing" -eq 1 ] && [ "${#roots[@]}" -eq 0 ]; then
        usage_error "doctor: --roots needs at least one directory"
        return
    fi
    doctor_run "${roots[@]}"
}

cmd_plain() {
    local cmd="$1" fn="$2"
    shift 2
    if [ "$#" -gt 0 ]; then
        usage_error "$cmd takes no arguments"
        return
    fi
    "$fn"
}

main() {
    local cmd="${1:-}"
    if [ "$#" -eq 0 ]; then
        usage_error "missing command"
        return
    fi
    shift
    case "$cmd" in
        install) cmd_install "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        status) cmd_plain status status_run "$@" ;;
        restore-system-git) cmd_plain restore-system-git gitup_restore_run "$@" ;;
        restore-smartgit) cmd_plain restore-smartgit smartgit_restore_run "$@" ;;
        unlink-desktop-git) cmd_plain unlink-desktop-git desktop_git_unlink_run "$@" ;;
        doctor) cmd_doctor "$@" ;;
        update) cmd_plain update winupdate_run "$@" ;;
        version | --version) cmd_plain "$cmd" cli_version "$@" ;;
        help | --help | -h) cmd_plain "$cmd" cli_usage "$@" ;;
        *) usage_error "unknown command [$cmd]" ;;
    esac
}

# ^ order exit right after main => bash reads no further in a script install or uninstall may replace mid-run
main "$@"
exit

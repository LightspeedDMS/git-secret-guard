#!/usr/bin/env bash
# shellcheck disable=SC2016
# ^ external mirrors betterleaks 1.9.0 => leaks exit --exit-code with a JSON array, clean exits 0 with [], fatal exits 1 without a report
# ^ see test:test_real_betterleaks_exit_code_semantics_1_9_0
set -u
# ^ external macOS 12 has no /usr/bin/jq and a GUI PATH has none at all; the harness passes the jq it resolved, a missing value fails loudly
jq="${STUB_JQ:?STUB_JQ names the jq the harness resolved (TEST_JQ in tests/support/lib.sh)}"
marker="${STUB_MARKER:-NOMARKER}"
[ -n "${STUB_LOG:-}" ] && printf 'betterleaks %s\n' "$*" >>"$STUB_LOG"
scan_dir="${2:-}"
report="" leak_rc=1 config="" ignore="" enable_rule=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
        --report-path) report="${args[$((i + 1))]:-}" ;;
        --exit-code) leak_rc="${args[$((i + 1))]:-1}" ;;
        --config) config="${args[$((i + 1))]:-}" ;;
        --enable-rule) enable_rule="${args[$((i + 1))]:-}" ;;
        --gitleaks-ignore-path) ignore="${args[$((i + 1))]:-}" ;;
    esac
done
if [ -n "${STUB_LOG:-}" ]; then
    printf 'betterleaks-config=%s ignore=%s cwd=%s\n' "$config" "$ignore" "$PWD" >>"$STUB_LOG"
    if [ -f "$config" ]; then sed 's/^/betterleaks-config-line: /' "$config" >>"$STUB_LOG"; fi
    if [ -f "$ignore/.gitleaksignore" ]; then sed 's/^/betterleaks-ignore-line: /' "$ignore/.gitleaksignore" >>"$STUB_LOG"; fi
    # ^ invariant logs the network-related environment the scanner got => test:test_the_scanner_runs_with_a_dead_proxy_and_no_proxy_exemption
    printf 'proxyenv=%s|%s|%s|%s|%s|%s|%s|%s\n' "${HTTP_PROXY-unset}" "${HTTPS_PROXY-unset}" "${ALL_PROXY-unset}" \
        "${http_proxy-unset}" "${https_proxy-unset}" "${all_proxy-unset}" "${NO_PROXY-unset}" "${no_proxy-unset}" >>"$STUB_LOG"
fi
# ^ external the pre-flight (no --report-path) scans a probe holding a built-in-rule secret => exit --exit-code if the config keeps built-in rules, else 0
# ^ why sense a "useDefault = true" line, not parse the TOML; only the real-betterleaks tests settle what a config means
# ^ external the machine probe (doctor, install) runs "betterleaks --version" => a test needing it to match the pin sets STUB_VERSION to the pinned version
if [ "${1:-}" = --version ] && [ -n "${STUB_VERSION:-}" ]; then
    printf 'betterleaks version %s\n' "$STUB_VERSION"
    exit 0
fi
if [ -z "$report" ]; then
    # ^ why only the "dir" call sleeps, not every call without a report path; the version probe has none either, and must not pay the pre-flight's sleep
    if [ -n "${STUB_GL_PREFLIGHT_SLEEP:-}" ] && [ "${1:-}" = dir ]; then exec sleep "$STUB_GL_PREFLIGHT_SLEEP"; fi
    if [ -n "${STUB_GL_PREFLIGHT_ERROR:-}" ]; then printf '1:00AM FTL %s\n' "$STUB_GL_PREFLIGHT_ERROR" >&2; fi
    if [ -n "${STUB_LOG:-}" ] && [ -d "$scan_dir" ]; then
        while IFS= read -r f; do
            printf 'betterleaks-target-file: %s\n' "${f#"$scan_dir"/}" >>"$STUB_LOG"
            sed 's/^/betterleaks-target-line: /' "$f" >>"$STUB_LOG"
        done < <(find "$scan_dir" -type f | LC_ALL=C sort)
    fi
    if [ -n "${STUB_GL_PREFLIGHT_RC:-}" ]; then exit "$STUB_GL_PREFLIGHT_RC"; fi
    if [ -f "$config" ] && grep -q '^useDefault = true' "$config"; then exit "$leak_rc"; fi
    exit 0
fi
if [ -n "${STUB_RECORD:-}" ] && [ -d "$scan_dir" ]; then
    while IFS= read -r f; do
        printf '== %s\n' "${f#"$scan_dir"/}" >>"$STUB_RECORD.betterleaks"
        cat -- "$f" >>"$STUB_RECORD.betterleaks"
    done < <(find "$scan_dir" -type f | LC_ALL=C sort)
fi
if [ -n "${STUB_GL_STUBBORN:-}" ]; then
    trap '' TERM
    for _ in 1 2 3; do sleep "${STUB_GL_SLEEP:-1}"; done
fi
[ -n "${STUB_GL_SLEEP:-}" ] && sleep "$STUB_GL_SLEEP"
[ -n "${STUB_GL_STDERR:-}" ] && printf '%s\n' "$STUB_GL_STDERR" >&2
rc_override="${STUB_GL_RC:-}" findings="${STUB_GL_FINDINGS:-}"
# ^ external the adapter's rule-only run passes --enable-rule => it has its own status and findings variables
if [ -n "$enable_rule" ]; then rc_override="${STUB_GL_EXTRA_RC:-}" findings="${STUB_GL_EXTRA_FINDINGS:-}"; fi
if [ -n "$rc_override" ]; then exit "$rc_override"; fi

if [ -n "${STUB_GL_BADREPORT:-}" ]; then
    printf '%s\n' "$STUB_GL_BADREPORT" >"$report"
    exit "$leak_rc"
fi
if [ -n "$findings" ]; then
    IFS=';' read -ra entries <<<"$findings"
    for e in "${entries[@]}"; do
        IFS='|' read -r rule rel line <<<"$e"
        file="$rel"
        if [ "$scan_dir" != . ]; then file="$scan_dir/$rel"; fi
        "$jq" -nc --arg r "$rule" --arg f "$file" --argjson l "$line" --arg m "$marker" \
            '{RuleID:$r,Description:("leak "+$m),StartLine:$l,EndLine:$l,Match:$m,Secret:$m,File:$f,
              Fingerprint:($f+":"+$r+":"+($l|tostring)),Entropy:4.1,Tags:[]}'
    done | "$jq" -s . >"$report"
    exit "$leak_rc"
fi
printf '[]\n' >"$report"
exit 0

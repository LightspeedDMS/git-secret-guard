#!/usr/bin/env bash
set -u
set -o pipefail
# ^ why SECONDS, not EPOCHREALTIME or date +%N; bash 4.4 and BSD date have neither, whole seconds (off by up to one) need nothing else
SECONDS=0

block() {
    printf 'git-secret-guard: %s\n' "$1" >&2
    printf 'To bypass this check for one commit: git commit --no-verify\n' >&2
    exit 1
}

# ^ external macOS /bin/bash is 3.2 and a GUI git client puts it first on PATH; the hook needs bash 4.4 and blocks under anything older
# ^ invariant this check uses bash 3.2 syntax only and runs before any library is read => an old bash stops here, never later at a syntax error
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
    block "this hook needs bash 4.4 or newer and is running under bash ${BASH_VERSION:-unknown}; run git-secret-guard install again so the hook command names the Homebrew bash; nothing was scanned."
fi

SELF="$(realpath -- "${BASH_SOURCE[0]}")" || block "cannot resolve the location of the scan script; nothing was scanned."
SHARE="${SELF%/*/*}"

for lib in common.sh extract.sh exempt.sh report.sh; do
    # shellcheck source=/dev/null
    source "$SHARE/lib/$lib" || block "cannot load $SHARE/lib/$lib; nothing was scanned."
done

# ^ hazard GIT_LITERAL_PATHSPECS (git --literal-pathspecs sets it) => exclude pathspecs match nothing, every diff is empty, commit passes unscanned
# ^ security unset all four pathspec variables before any diff; test:test_the_literal_pathspecs_flag_cannot_disable_the_excludes
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
# ^ hazard git replace <HEAD> <permissive commit> => ls-tree HEAD returns a file outside the branch history, exemptions come from it
# ^ security GIT_NO_REPLACE_OBJECTS=1 => HEAD reads and the staged diff use real objects
# ^ see test:test_a_replace_ref_on_head_cannot_substitute_a_permissive_ignore_file
export GIT_NO_REPLACE_OBJECTS=1

load_settings "$SHARE/settings" || block "cannot read the settings file; nothing was scanned."

# ^ external macOS ships BSD tools without the GNU flags the hook uses (chmod 700 -- DIR, mktemp, cp -a); install records the GNU directory as GNUBIN_DIR
# ^ security GNUBIN_DIR comes from the settings file only and must be an absolute directory => anything else blocks, nothing is scanned
if [ -n "${GNUBIN_DIR:-}" ]; then
    if [ "${GNUBIN_DIR#/}" = "$GNUBIN_DIR" ] || [ ! -d "$GNUBIN_DIR" ]; then
        block "GNUBIN_DIR in the settings file is not an absolute directory ($GNUBIN_DIR); nothing was scanned."
    fi
    PATH="$GNUBIN_DIR:$PATH"
    export PATH
fi

problems=()
for spec in "jq:${JQ_BIN:-}" "trufflehog:${TRUFFLEHOG_BIN:-}" "betterleaks:${BETTERLEAKS_BIN:-}" "setsid:${SETSID_BIN:-}" "timeout:${TIMEOUT_BIN:-}"; do
    if msg="$(tool_unusable "${spec%%:*}" "${spec#*:}")"; then
        problems+=("$msg")
    fi
done
if [ "${#problems[@]}" -gt 0 ]; then
    for msg in "${problems[@]}"; do printf '%s: %s\n' "$GSG_NAME" "$msg" >&2; done
    block "commit blocked; nothing was scanned."
fi

work="" tpid="" gpid="" tpgid="" gpgid=""

# ^ invariant runner pid = its process group id (setsid) => kill -- -pgid reaches runner, timeout and scanner
# ^ invariant tpgid/gpgid are never cleared => grandchildren of a timed-out scanner still get stopped
# ^ hazard signal before the child's setsid() => no group yet; the fallback kills the pid, only for an unreaped child
# shellcheck disable=SC2329
stop_group() {
    local pgid="$1" pid="$2" i
    if [ -z "$pgid" ]; then return 0; fi
    kill -TERM -- "-$pgid" 2>/dev/null || { [ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null; }
    if [ -n "$pid" ]; then wait "$pid" 2>/dev/null; fi
    for ((i = 0; i < 50; i++)); do
        if ! kill -0 -- "-$pgid" 2>/dev/null; then return 0; fi
        sleep 0.1
    done
    kill -KILL -- "-$pgid" 2>/dev/null || { [ -z "$pid" ] || kill -KILL "$pid" 2>/dev/null; }
    return 0
}

# ^ order stop_group before rm => a surviving adapter (betterleaks cp -a) cannot re-create files with the added lines after the rm
# shellcheck disable=SC2329
cleanup() {
    stop_group "$tpgid" "$tpid"
    stop_group "$gpgid" "$gpid"
    if [ -n "$work" ]; then rm -rf -- "$work"; fi
}
# ^ order traps before mktemp and umask 077 before the first secret-bearing file => no leftovers on any exit, nothing readable by others
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
umask 077
tmp_base="${TMPDIR:-}"
if [ -z "$tmp_base" ]; then
    [ -n "${HOME:-}" ] || block "neither TMPDIR nor HOME is set; nothing was scanned."
    tmp_base="$HOME/.tmp"
fi
mkdir -p -- "$tmp_base" || block "cannot create the temp base directory $tmp_base; nothing was scanned."
work="$(mktemp -d -- "$tmp_base/git-secret-guard.XXXXXXXX")" || block "cannot create a private temp directory under $tmp_base; nothing was scanned."
chmod 700 -- "$work" || block "cannot make the temp directory private; nothing was scanned."

exempt_load "$work" || block "could not apply the repository's exemptions from HEAD; nothing was scanned."

GSG_EXEMPTED=0
exempt_extract_tree "$work/scan" "${GSG_EXCLUDES[@]}" \
    || block "extracting the added lines of the staged diff failed (git diff --cached failed, the diff held an unsafe path, or a scan file could not be written; the line above says which, if it can); nothing was scanned."
if [ "${#GSG_EXCLUDES[@]}" -gt 0 ]; then
    exempt_report_exclusions "${GSG_EXCLUDES[@]}" || block "could not count the files excluded by $GSG_IGNORE_FILE; nothing was scanned."
fi

first_file="$(find "$work/scan" -type f -print -quit)" || block "cannot inspect the scan tree; nothing was scanned."
if [ -z "$first_file" ]; then
    report_nothing_line "$GSG_EXEMPTED"
    exit 0
fi

# ^ why setsid per runner, not a plain subshell; timeout and scanner share one signalable group, outliving the runner
# ^ security "$SETSID_BIN" from settings, not PATH => a planted setsid earlier on PATH cannot replace the runner start
"$SETSID_BIN" "$BASH" "$SHARE/lib/run-scanner.sh" trufflehog "$work/scan" "$work" &
tpid=$!
tpgid=$tpid
"$SETSID_BIN" "$BASH" "$SHARE/lib/run-scanner.sh" betterleaks "$work/scan" "$work" &
gpid=$!
gpgid=$gpid
wait "$tpid"
trc=$?
tpid=""
wait "$gpid"
grc=$?
gpid=""
blocked=0
if [ "$trc" -ne 0 ]; then
    printf 'trufflehog: scan wrapper failed internally (exit %s)\n' "$trc" >&2
    blocked=1
fi
if [ "$grc" -ne 0 ]; then
    printf 'betterleaks: scan wrapper failed internally (exit %s)\n' "$grc" >&2
    blocked=1
fi
report_results "$work" || blocked=1

if [ "$blocked" -ne 0 ]; then
    printf 'To bypass this check for one commit: git commit --no-verify\n' >&2
    exit 1
fi
report_pass_line "$GSG_EXTRACT_FILES" "$GSG_EXTRACT_LINES" "$GSG_EXEMPTED" "$SECONDS"
exit 0

#!/usr/bin/env bash
set -u
set -o pipefail
# ^ why SECONDS, not EPOCHREALTIME or date +%N; bash 4.4 and BSD date have neither, whole seconds (off by up to one) need nothing else
SECONDS=0

# ^ order REMINDER_READY is 1 only after run_reminder exists and the work dir holds its output; an earlier block gets no reminder
REMINDER_READY=0

block() {
    printf 'git-secret-guard: %s\n' "$1" >&2
    printf 'To bypass this check for one commit: git commit --no-verify\n' >&2
    if [ "$REMINDER_READY" -eq 1 ]; then run_reminder; fi
    exit 1
}

# ^ external macOS /bin/bash is 3.2 and a GUI git client puts it first on PATH; the hook needs bash 4.4 and blocks under anything older
# ^ invariant this check uses bash 3.2 syntax only and runs before any library is read => an old bash stops here, never later at a syntax error
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
    block "this hook needs bash 4.4 or newer and is running under bash ${BASH_VERSION:-unknown}; run git-secret-guard install again so the hook command names the Homebrew bash; nothing was scanned."
fi

SELF="$(realpath -- "${BASH_SOURCE[0]}")" || block "cannot resolve the location of the scan script; nothing was scanned."
SHARE="${SELF%/*/*}"

# shellcheck source=/dev/null
source "$SHARE/lib/common.sh" || block "cannot load $SHARE/lib/common.sh; nothing was scanned."
# ^ invariant an unset or empty list stops here => the hook never reaches a missing function by accident; [*] also catches a list of empty names
hook_libs_listed || block "cannot load the hook library list (GSG_HOOK_LIBS in $SHARE/lib/common.sh); nothing was scanned."
# ^ coupled the list is GSG_HOOK_LIBS in lib/common.sh, the one status checks too; test:test_the_hook_loads_exactly_the_libraries_in_the_shared_list
for lib in "${GSG_HOOK_LIBS[@]}"; do
    # shellcheck source=/dev/null
    source "$SHARE/lib/$lib" || block "cannot load $SHARE/lib/$lib; nothing was scanned."
done

# ^ hazard GIT_LITERAL_PATHSPECS (git --literal-pathspecs sets it) => exclude pathspecs match nothing, every diff is empty, commit passes unscanned
# ^ security unset all four pathspec variables before any diff; test:test_the_literal_pathspecs_flag_cannot_disable_the_excludes
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
# ^ hazard git replace <HEAD> <permissive commit> => ls-tree HEAD returns a file outside the branch history, exemptions come from it
# ^ security GIT_NO_REPLACE_OBJECTS=1 => HEAD reads and the staged diff use real objects
# ^ see test:test_a_replace_ref_on_head_cannot_substitute_a_permissive_ignore_file
export GIT_NO_REPLACE_OBJECTS=1

load_settings "$SHARE/settings" || block "cannot read the settings file; nothing was scanned."

# ^ external macOS ships BSD tools without the GNU flags the hook uses (chmod 700 -- DIR, mktemp, cp -a); install records the GNU directory as GNUBIN_DIR
# ^ security GNUBIN_DIR comes from the settings file only and must be an absolute directory => anything else blocks, nothing is scanned
if [ -n "${GNUBIN_DIR:-}" ]; then
    if gnubin_dir_unusable; then
        block "GNUBIN_DIR in the settings file is not an absolute directory ($GNUBIN_DIR); nothing was scanned."
    fi
    PATH="$GNUBIN_DIR:$PATH"
    export PATH
fi

# ^ invariant the process tool is setsid on Linux and macOS, taskkill on Windows; only the one of this platform is required
if proc_is_windows; then proc_tool="taskkill:${TASKKILL_BIN:-}"; else proc_tool="setsid:${SETSID_BIN:-}"; fi
problems=()
for spec in "jq:${JQ_BIN:-}" "trufflehog:${TRUFFLEHOG_BIN:-}" "betterleaks:${BETTERLEAKS_BIN:-}" "$proc_tool" "timeout:${TIMEOUT_BIN:-}"; do
    if msg="$(tool_unusable "${spec%%:*}" "${spec#*:}")"; then
        problems+=("$msg")
    fi
done
if [ "${#problems[@]}" -gt 0 ]; then
    for msg in "${problems[@]}"; do printf '%s: %s\n' "$GSG_NAME" "$msg" >&2; done
    block "commit blocked; nothing was scanned."
fi

work="" tpid="" gpid="" tpgid="" gpgid="" rpid="" rpgid=""

# ^ order stop before rm => a surviving adapter (betterleaks cp -a) cannot re-create files with the added lines after the rm
# ^ hazard Windows refuses to delete a directory with a file still open in it => retry once, else name it; it holds the staged added lines
# shellcheck disable=SC2329
cleanup() {
    proc_stop_group "$tpgid" "$tpid"
    proc_stop_group "$gpgid" "$gpid"
    proc_stop_group "$rpgid" "$rpid"
    if [ -n "$work" ]; then
        rm -rf -- "$work"
        if [ -d "$work" ] && proc_is_windows; then
            sleep 1
            rm -rf -- "$work"
        fi
        if [ -d "$work" ]; then
            printf '%s: could not remove the temporary scan directory %s; it holds the added lines of your staged changes, delete it by hand\n' "$GSG_NAME" "$work" >&2
        fi
    fi
}
# ^ order traps before mktemp and umask 077 before the first secret-bearing file => no leftovers on any exit, nothing readable by others
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
umask 077
tmp_base="${TMPDIR:-}"
# ^ hazard NTFS ignores umask and chmod, and Git for Windows sh sets TMPDIR=/tmp => on Windows only a TMPDIR under HOME is used (profile ACL)
if proc_is_windows && { [ -z "${HOME:-}" ] || [[ "$tmp_base/" != "$HOME"/* ]]; }; then tmp_base=""; fi
if [ -z "$tmp_base" ]; then
    [ -n "${HOME:-}" ] || block "neither TMPDIR nor HOME is set; nothing was scanned."
    tmp_base="$HOME/.tmp"
fi
mkdir -p -- "$tmp_base" || block "cannot create the temp base directory $tmp_base; nothing was scanned."
work="$(mktemp -d -- "$tmp_base/git-secret-guard.XXXXXXXX")" || block "cannot create a private temp directory under $tmp_base; nothing was scanned."
chmod 700 -- "$work" || block "cannot make the temp directory private; nothing was scanned."

# ^ why one runner per scanner, not a plain subshell; timeout and scanner share one stoppable unit outliving the runner's own shell, see lib/proc.sh
# ^ invariant arg 1 = the report mode ("" or message); scans "$work/scan" with both tools and prints the report; rc 1 = blocked, the text is printed
run_scanners() {
    local trc grc blocked=0
    proc_start_runner trufflehog "$work/scan" "$work" tpid tpgid || block "cannot start the trufflehog scan (the runner's Windows pid could not be read); nothing was scanned."
    proc_start_runner betterleaks "$work/scan" "$work" gpid gpgid || block "cannot start the betterleaks scan (the runner's Windows pid could not be read); nothing was scanned."
    wait "$tpid"
    trc=$?
    tpid=""
    wait "$gpid"
    grc=$?
    gpid=""
    if [ "$trc" -ne 0 ]; then
        printf 'trufflehog: scan wrapper failed internally (exit %s)\n' "$trc" >&2
        blocked=1
    fi
    if [ "$grc" -ne 0 ]; then
        printf 'betterleaks: scan wrapper failed internally (exit %s)\n' "$grc" >&2
        blocked=1
    fi
    report_results "$work" "${1:-}" || blocked=1
    [ "$blocked" -eq 0 ]
}

# ^ invariant pre-commit passes no argument and commit-msg passes the message file; one argument is the commit-msg run, anything else blocks
# ^ order this branch comes before run_reminder and REMINDER_READY => the commit-msg run never starts the coverage reminder, not even on a block
# ^ why exempt_load_config_only, not exempt_load; a path exemption names files and a message is none, HEAD's betterleaks files are announced as in the lines run
if [ "$#" -gt 0 ]; then
    [ "$#" -eq 1 ] || block "the commit-msg run needs exactly one argument, the message file, and got $#; nothing was scanned."
    message_scan_prepare "$1" "$work/scan" || block "cannot read the commit message file git passed; nothing was scanned."
    exempt_load_config_only "$work" || block "could not apply the repository's betterleaks files from HEAD; nothing was scanned."
    # ^ why an empty file skips the scan, not a scan of nothing; trufflehog logs chunks 0 for an empty tree, a failed scan to the hook
    if [ ! -s "$work/scan/$GSG_MESSAGE_SCAN_NAME" ]; then exit 0; fi
    if ! run_scanners message; then
        printf 'To bypass this check for one commit: git commit --no-verify\n' >&2
        exit 1
    fi
    exit 0
fi

# ^ invariant every failure is one line on stderr and a return 0 => the commit keeps its own exit status
# ^ why a separate process through "$BASH", not sourced doctor code; the hook never loads doctor libraries
# ^ security own session and repository-local GIT_* unset => the re-check reads other repositories; doctor stderr is discarded, only its stdout is used
run_reminder() {
    local dir file rrc vars why v
    local -a local_vars=() launcher=()
    dir="$(state_dir_path)" || {
        report_reminder_failed "neither XDG_STATE_HOME nor HOME is set"
        return 0
    }
    if [ "${dir#/}" = "$dir" ]; then
        report_reminder_failed "the state directory is not an absolute path"
        return 0
    fi
    file="$dir/findings"
    if ! report_reminder_due "$file"; then return 0; fi
    vars="$(git rev-parse --local-env-vars)" || {
        report_reminder_failed "git rev-parse --local-env-vars failed"
        return 0
    }
    mapfile -t local_vars <<<"$vars"
    # ^ security the scan tree holds this commit's added lines and the scanner files name findings => the work dir is emptied before the re-check can run
    find "$work" -mindepth 1 -delete || {
        report_reminder_failed "cannot clear the work dir"
        return 0
    }
    # ^ why no total time limit, not a bound; every recorded problem is re-checked, each git call keeps DOCTOR_TIMEOUT_SECONDS inside doctor
    # ^ external Windows has no setsid and settings hold no SETSID_BIN => the job starts plain, proc_stop_group walks its process tree
    if ! proc_is_windows; then launcher=("$SETSID_BIN"); fi
    (
        for v in "${local_vars[@]}"; do unset "$v"; done
        exec "${launcher[@]}" "$BASH" "$SHARE/bin/git-secret-guard" doctor --recheck </dev/null >"$work/recheck.out" 2>/dev/null
    ) &
    rpid=$!
    rpgid=$rpid
    # ^ external bash prints a "Killed" job message for a signalled child; the one failure line reports the status instead
    { wait "$rpid"; } 2>/dev/null
    rrc=$?
    rpid=""
    if [ "$rrc" -eq 0 ]; then return 0; fi
    why="doctor --recheck exit $rrc"
    if [ "$rrc" -eq 1 ]; then
        if report_reminder "$work/recheck.out" "$file"; then return 0; fi
        why="doctor --recheck printed nothing readable"
    fi
    report_reminder_failed "$why"
    return 0
}
REMINDER_READY=1

exempt_load "$work" || block "could not apply the repository's exemptions from HEAD; nothing was scanned."

GSG_EXEMPTED=0
# ^ order before the first diff => the extraction, the exemption pass, the LFS code and the counts all read this one staged tree
staged_trees_init "$work" || block "cannot write the staged tree (git write-tree failed or the base tree is unreadable; the line above says which, if it can); nothing was scanned."
exempt_extract_tree "$work/scan" "${GSG_EXCLUDES[@]}" \
    || block "extracting the added lines of the staged diff failed (git diff-tree failed, the diff held an unsafe path, or a scan file could not be written; the line above says which, if it can); nothing was scanned."
# ^ order after the extraction and before the pass line => a pointer's scan file is replaced by its object and the counts follow
extract_lfs_objects "$work/scan" \
    || block "$(lfs_block_text)"
if [ "${#GSG_EXCLUDES[@]}" -gt 0 ]; then
    exempt_report_exclusions "${GSG_EXCLUDES[@]}" || block "could not count the files excluded by $GSG_IGNORE_FILE; nothing was scanned."
fi

first_file="$(find "$work/scan" -type f -print -quit)" || block "cannot inspect the scan tree; nothing was scanned."
if [ -z "$first_file" ]; then
    report_nothing_line "$GSG_EXEMPTED"
    run_reminder
    exit 0
fi

if ! run_scanners; then
    printf 'To bypass this check for one commit: git commit --no-verify\n' >&2
    run_reminder
    exit 1
fi
report_pass_line "$GSG_EXTRACT_FILES" "$GSG_EXTRACT_LINES" "$GSG_EXEMPTED" "$SECONDS"
run_reminder
exit 0
